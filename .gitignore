# 依赖与构建产物
frontend/node_modules/
frontend/dist/
frontend/.vite/

# 后端构建 / 内置 Node / 静态资源
backend/target/
backend/.node/
# 前端静态源入库，第三方 vendor 库不入库
backend/src/main/resources/static/**
!backend/src/main/resources/static/README.txt
!backend/src/main/resources/static/*.html
!backend/src/main/resources/static/.nojekyll
!backend/src/main/resources/static/js/
!backend/src/main/resources/static/js/**
!backend/src/main/resources/static/css/
!backend/src/main/resources/static/css/**
!backend/src/main/resources/static/data/
!backend/src/main/resources/static/data/**
# 厂商原始抓包数据不入库
backend/src/main/resources/static/data/raw/
!backend/src/main/resources/static/docs/
!backend/src/main/resources/static/docs/**
backend/src/main/resources/static/vendor/

# data 联接目录（真实数据在 public/data，避免重复入库）
frontend/data/

# 传感器网关运行时
sensor_bridge/store/
**/__pycache__/
*.pyc
.env
.env.*

# 敏感 / 调试临时文件
frontend/assets/_token.txt
frontend/assets/cap_*.txt
frontend/assets/cap_*.png
frontend/assets/captcha*.png
frontend/assets/_*.js
frontend/assets/_*.html
frontend/assets/_*.txt

